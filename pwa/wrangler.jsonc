{
    "name": "ucp-noticeboard",
    "compatibility_date": "2026-08-20",
    // The app's files, plus /api passed on to the NoticeBoard server (worker.js).
    "main": "./worker.js",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/api"]
    },
    "vars": {
        "API_ORIGIN": "https://ucpnb-api.duckdns.org"
    }
}
