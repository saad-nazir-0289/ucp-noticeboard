{
  "manifest_version": 3,
  "name": "UCP NoticeBoard",
  "version": "1.26.0",
  "description": "Injects a live NoticeBoard into the UCP Student Portal dashboard.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://horizon.ucp.edu.pk/*"
  ],
  "action": {
    "default_title": "UCP NoticeBoard",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://horizon.ucp.edu.pk/*"
      ],
      "js": [
        "horizon-theme.js"
      ],
      "css": [
        "horizon-skin.css",
        "horizon-theme.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://horizon.ucp.edu.pk/student/dashboard*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
