# The API's settings. Lives at /opt/ucpnb/config/production.env (only you can read it).
# Edit with: nano /opt/ucpnb/config/production.env

# Websites allowed to use the API, separated by commas, no spaces.
# While testing, add your test website's address at the end, for example:
#   ...workers.dev,https://ucp-noticeboard-staging.YOURNAME.workers.dev
Cors__AllowedOrigins=https://horizon.ucp.edu.pk,https://ucp-noticeboard.msndev.workers.dev
Pwa__BaseUrl=https://ucp-noticeboard.msndev.workers.dev

# Replace each RAILWAY with the value of the same name from Railway
# (your API service → Variables; there the names may use ":" or "__").
# The same values keep everyone's notifications and admin links working.
AdminActivationSecret=RAILWAY
VapidSettings__PublicKey=RAILWAY
VapidSettings__PrivateKey=RAILWAY
VapidSettings__Subject=RAILWAY
Cloudinary__CloudName=RAILWAY
Cloudinary__ApiKey=RAILWAY
Cloudinary__ApiSecret=RAILWAY

# A fresh random key was put here for you. Optionally replace it with
# Railway's Jwt__Key, so students stay signed in after the move.
Jwt__Key=RAILWAY
