# Production API settings. Lives at /opt/ucpnb/config/production.env (only you can read it).
# Copy the values marked RAILWAY from Railway → your API service → Variables,
# so existing notification subscriptions and admin links keep working.

Cors__AllowedOrigins=https://horizon.ucp.edu.pk,https://ucp-noticeboard.msndev.workers.dev
Pwa__BaseUrl=https://ucp-noticeboard.msndev.workers.dev

# RAILWAY: keep the same values.
AdminActivationSecret=RAILWAY
VapidSettings__PublicKey=RAILWAY
VapidSettings__PrivateKey=RAILWAY
VapidSettings__Subject=RAILWAY
Cloudinary__CloudName=RAILWAY
Cloudinary__ApiKey=RAILWAY
Cloudinary__ApiSecret=RAILWAY

# RAILWAY if you like (students simply sign in again otherwise; it's automatic).
Jwt__Key=RAILWAY
