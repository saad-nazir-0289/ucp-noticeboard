# Staging API settings. Lives at /opt/ucpnb/config/staging.env (only you can read it).
# setup.sh fills in the secrets; you fill in the staging site's address.

# Where students' browsers may call this API from: the portal and the staging site.
Cors__AllowedOrigins=https://horizon.ucp.edu.pk,STAGING_PWA_URL
# The staging site (second Cloudflare Worker), e.g. https://ucp-noticeboard-staging.msndev.workers.dev
Pwa__BaseUrl=STAGING_PWA_URL

# Generated by setup.sh. Never reuse production's.
Jwt__Key=GENERATED
AdminActivationSecret=GENERATED

# Fill the empty database with the demo users and notices.
SeedDemoData=true

# Optional, to try those features on staging. Use a separate VAPID key pair
# (npx web-push generate-vapid-keys) so staging can never notify real students.
#VapidSettings__PublicKey=
#VapidSettings__PrivateKey=
#VapidSettings__Subject=mailto:you@example.com
#Cloudinary__CloudName=
#Cloudinary__ApiKey=
#Cloudinary__ApiSecret=
